@model SalesOrder
@{ ViewData["Title"] = "Order details"; }
<div class="page-heading"><div><div class="eyebrow">Sales / Order details</div><h1>@Model.OrderNumber</h1><p class="subheading">Created for @Model.Customer?.Name on @Model.OrderDate.ToString("dd MMM yyyy")</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Back to orders</a></div>
<div class="row g-4"><div class="col-lg-8"><section class="panel"><div class="panel-heading"><h2>Order items</h2><span class="status-pill status-@Model.Status.ToLowerInvariant()">@Model.Status</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>SKU</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Line total</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Product?.Name</td><td>@item.Product?.SKU</td><td class="text-end">@item.Quantity</td><td class="text-end">R @item.UnitPrice.ToString("N2")</td><td class="text-end fw-semibold">R @item.LineTotal.ToString("N2")</td></tr> }</tbody><tfoot><tr><th colspan="4" class="text-end">Order total</th><th class="text-end">R @Model.Total.ToString("N2")</th></tr></tfoot></table></div></section></div>
<div class="col-lg-4"><section class="panel"><div class="panel-heading"><h2>Order management</h2></div><div class="panel-body"><p class="text-secondary small mb-1">Customer</p><p class="fw-semibold">@Model.Customer?.Name</p><p class="text-secondary small mb-1">Notes</p><p>@(Model.Notes ?? "No notes added.")</p><hr/><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label" for="status">Update status</label><select class="form-select mb-3" id="status" name="status"><option selected="@(Model.Status == "Pending")">Pending</option><option selected="@(Model.Status == "Processing")">Processing</option><option selected="@(Model.Status == "Completed")">Completed</option><option selected="@(Model.Status == "Cancelled")">Cancelled</option></select><button class="btn btn-primary w-100">Save status</button></form><p class="small text-secondary mt-3 mb-0">Cancelling an order restores its stock once. Cancelled orders cannot be reactivated automatically.</p></div></section></div></div>
