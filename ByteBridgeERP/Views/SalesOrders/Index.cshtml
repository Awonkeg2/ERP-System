@model IEnumerable<SalesOrder>
@{ ViewData["Title"] = "Sales orders"; }
<div class="page-heading"><div><div class="eyebrow">Workspace / Sales</div><h1>Sales orders</h1><p class="subheading">Create orders, track progress and keep stock in sync.</p></div><a class="btn btn-primary px-3 py-2" asp-action="Create">＋ Create sales order</a></div>
<form method="get" class="mb-3 d-flex gap-2" style="max-width:360px"><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var s in new[] {"Pending","Processing","Completed","Cancelled"}) { <option value="@s" selected="@(ViewData["Status"]?.ToString() == s)">@s</option> }</select><button class="btn btn-outline-secondary">Filter</button></form>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Order number</th><th>Customer</th><th>Date</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="6"><div class="empty-state">No sales orders found.</div></td></tr> } @foreach (var o in Model) { <tr><td class="fw-bold">@o.OrderNumber</td><td>@o.Customer?.Name</td><td>@o.OrderDate.ToString("dd MMM yyyy")</td><td><span class="status-pill status-@o.Status.ToLowerInvariant()">@o.Status</span></td><td class="text-end fw-semibold">R @o.Total.ToString("N2")</td><td class="text-end"><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">View order</a></td></tr> }</tbody></table></div></section>
