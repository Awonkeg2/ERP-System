@model IEnumerable<Account>
@{ ViewData["Title"] = "Chart of accounts"; }
<div class="page-heading"><div><div class="eyebrow">Finance / Accounting</div><h1>Chart of accounts</h1><p class="subheading">A starter list of asset, liability, equity, income and expense accounts.</p></div><a asp-action="CreateAccount" class="btn btn-primary">＋ Add account</a></div>
<div class="alert alert-warning small">Accounts are currently a chart-of-accounts list only. Transactions are not posted to these accounts, so this is not yet a double-entry general ledger.</div>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Code</th><th>Account name</th><th>Type</th><th>Description</th><th class="text-end">Opening balance</th><th>Status</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="6"><div class="empty-state">No accounts configured.</div></td></tr> } @foreach (var a in Model) { <tr><td class="fw-bold">@a.Code</td><td>@a.Name</td><td><span class="status-pill">@a.Type</span></td><td>@(a.Description ?? "—")</td><td class="text-end">R @a.OpeningBalance.ToString("N2")</td><td>@(a.IsActive ? "Active" : "Inactive")</td></tr> }</tbody></table></div></section>
