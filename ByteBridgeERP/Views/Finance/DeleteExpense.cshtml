@model Expense
@{ ViewData["Title"] = "Delete expense"; }
<div class="page-heading"><div><div class="eyebrow">Finance / Expenses</div><h1>Delete expense?</h1><p class="subheading">This removes the expense record from this prototype.</p></div></div>
