@model FinanceDashboardViewModel
@{ ViewData["Title"] = "Finance & accounting"; }
<div class="page-heading"><div><div class="eyebrow">Workspace / Finance</div><h1>Finance & accounting</h1><p class="subheading">Monitor sales, recorded expenses and your chart of accounts.</p></div><div class="action-links"><a class="btn btn-outline-primary" asp-action="Accounts">Chart of accounts</a><a class="btn btn-primary" asp-action="CreateExpense">＋ Record expense</a></div></div>
<div class="alert alert-info small">Starter financial overview only: revenue is calculated from non-cancelled sales orders, not from confirmed payments. This is not a general ledger or a tax-compliant accounting package.</div>
<div class="row g-3 mb-4">
<div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-top"><span>Order revenue</span><span class="metric-icon">R</span></div><div class="metric-value">R @Model.Revenue.ToString("N2")</div><div class="metric-foot">Non-cancelled orders</div></div></div>
<div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-top"><span>Paid expenses</span><span class="metric-icon">↗</span></div><div class="metric-value">R @Model.Expenses.ToString("N2")</div><div class="metric-foot">@Model.ExpenseCount recorded expenses</div></div></div>
<div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-top"><span>Net result (estimate)</span><span class="metric-icon">±</span></div><div class="metric-value">R @Model.NetResult.ToString("N2")</div><div class="metric-foot">Order revenue less paid expenses</div></div></div>
<div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-top"><span>Open order value</span><span class="metric-icon">◷</span></div><div class="metric-value">R @Model.OutstandingOrders.ToString("N2")</div><div class="metric-foot">Pending and processing orders</div></div></div>
</div>
<div class="row g-4">
<div class="col-xl-7"><section class="panel"><div class="panel-heading"><h2>Recent expenses</h2><a asp-action="Expenses" class="small text-decoration-none">View all →</a></div>
@if (!Model.RecentExpenses.Any()) { <div class="empty-state">No expenses recorded yet.</div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Expense</th><th>Status</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var e in Model.RecentExpenses) { <tr><td>@e.ExpenseDate.ToString("dd MMM yyyy")</td><td><div class="fw-semibold">@e.Description</div><small class="text-secondary">@e.Category · @e.Reference</small></td><td><span class="status-pill status-@(e.Status == "Paid" ? "completed" : "pending")">@e.Status</span></td><td class="text-end fw-semibold">R @e.Amount.ToString("N2")</td></tr> }</tbody></table></div> }</section></div>
<div class="col-xl-5"><section class="panel"><div class="panel-heading"><h2>Chart of accounts</h2><a asp-action="Accounts" class="small text-decoration-none">Manage →</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Account</th><th>Type</th></tr></thead><tbody>@foreach (var a in Model.Accounts) { <tr><td>@a.Code</td><td>@a.Name</td><td><span class="status-pill">@a.Type</span></td></tr> }</tbody></table></div></section></div>
</div>
