@model Expense
@{ ViewData["Title"] = "Record expense"; }
<div class="page-heading"><div><div class="eyebrow">Finance / New expense</div><h1>Record expense</h1><p class="subheading">Capture the business cost and payment status.</p></div><a asp-action="Expenses" class="btn btn-outline-secondary">← Back to expenses</a></div>
<div class="form-card"><form asp-action="CreateExpense" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /><span asp-validation-for="Description" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="">Choose category</option><option>Rent</option><option>Transport</option><option>Utilities</option><option>Stock / supplies</option><option>Marketing</option><option>Software / hosting</option><option>Wages</option><option>Professional fees</option><option>Other</option></select><span asp-validation-for="Category" class="text-danger small"></span></div>
<div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" /><span asp-validation-for="Amount" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="ExpenseDate" class="form-label"></label><input asp-for="ExpenseDate" type="date" class="form-control" /><span asp-validation-for="ExpenseDate" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Paid</option><option>Unpaid</option></select></div>
<div class="col-md-6"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select"><option>Bank transfer</option><option>Cash</option><option>Card</option><option>Other</option></select></div><div class="col-md-6"><label asp-for="PaidTo" class="form-label">Paid to / supplier</label><input asp-for="PaidTo" class="form-control" /><span asp-validation-for="PaidTo" class="text-danger small"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="3" class="form-control"></textarea></div></div>
<div class="d-flex gap-2 mt-4"><button class="btn btn-primary px-4" type="submit">Save expense</button><a asp-action="Expenses" class="btn btn-light">Cancel</a></div></form></div>
