@model IEnumerable<Expense>
@{ ViewData["Title"] = "Expenses"; }
<div class="page-heading"><div><div class="eyebrow">Finance / Expenses</div><h1>Expenses</h1><p class="subheading">Record and review business spending.</p></div><div class="action-links"><a asp-action="Index" class="btn btn-outline-secondary">Finance dashboard</a><a asp-action="CreateExpense" class="btn btn-primary">＋ Record expense</a></div></div>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Reference</th><th>Date</th><th>Description</th><th>Category</th><th>Status</th><th class="text-end">Amount</th><th></th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="7"><div class="empty-state">No expenses recorded yet.</div></td></tr> } @foreach (var e in Model) { <tr><td class="fw-semibold">@e.Reference</td><td>@e.ExpenseDate.ToString("dd MMM yyyy")</td><td><div>@e.Description</div><small class="text-secondary">@(e.PaidTo ?? "—")</small></td><td>@e.Category</td><td><span class="status-pill status-@(e.Status == "Paid" ? "completed" : "pending")">@e.Status</span></td><td class="text-end fw-semibold">R @e.Amount.ToString("N2")</td><td class="text-end"><a asp-action="DeleteExpense" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }</tbody></table></div></section>
