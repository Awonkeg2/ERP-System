@model Supplier
@{ ViewData["Title"] = "Supplier details"; }
<div class="page-heading"><div><div class="eyebrow">Suppliers / Details</div><h1>@Model.Name</h1><p class="subheading">Supplier record</p></div><div class="action-links"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit supplier</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="form-card"><dl class="row mb-0"><dt class="col-sm-4">Company</dt><dd class="col-sm-8">@(Model.Company ?? "—")</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@(Model.Phone ?? "—")</dd><dt class="col-sm-4">Address</dt><dd class="col-sm-8">@(Model.Address ?? "—")</dd><dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@(Model.Notes ?? "—")</dd></dl></div>
