@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-heading"><div><div class="eyebrow">Workspace / Customers</div><h1>Customers</h1><p class="subheading">Keep customer and business contact details in one place.</p></div><a class="btn btn-primary px-3 py-2" asp-action="Create">＋ Add new</a></div>
<form method="get" class="mb-3 d-flex gap-2" style="max-width:520px"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search records..." /><button class="btn btn-outline-secondary">Search</button><a asp-action="Index" class="btn btn-light">Clear</a></form>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr>
<th>Customer</th>
<th>Company</th>
<th>Email</th>
<th>Phone</th>
<th class="text-end">Actions</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="5"><div class="empty-state">No records found. Add your first record to get started.</div></td></tr> }
@foreach (var item in Model) { <tr>
<td>@item.Name</td>
<td>@(item.Company ?? "—")</td>
<td>@(item.Email ?? "—")</td>
<td>@(item.Phone ?? "—")</td>
<td><div class="action-links justify-content-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">View</a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></div></td></tr> }
</tbody></table></div></section>